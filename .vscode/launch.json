{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "gdb",
      "request": "attach",
      "name": "Attach to gdbserver",
      "executable": "${workspaceRoot}/kernel.bin",
      "target": "localhost:1234",
      "remote": true,
      "cwd": "${workspaceRoot}",
      "gdbpath": "gdb",
      "valuesFormatting": "parseText",
      "autorun": [
        "dir kernel",
        "dir boot",
        "dir bin",
        "dir lib"
      ]
    }
  ]
}